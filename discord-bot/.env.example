# Token du bot Discord (Developer Portal → Bot → Token)
DISCORD_TOKEN=

# Application ID (Developer Portal → General Information → Application ID)
CLIENT_ID=

# ID du serveur (clic droit → Copier l'identifiant). Obligatoire pour enregistrer les commandes.
GUILD_ID=

# Salon texte où sont publiés les embeds de parties
GAMES_CHANNEL_ID=

# Catégorie dans laquelle créer les salons vocaux d'équipe
VOICE_CATEGORY_ID=

# Catégorie d'archives (utilisée si VOICE_CLEANUP_MODE=archive)
ARCHIVE_CATEGORY_ID=

# delete = supprimer les salons à la fin | archive = les déplacer dans ARCHIVE_CATEGORY_ID
VOICE_CLEANUP_MODE=delete

# Nom exact du rôle autorisé à créer / clôturer une partie
ORGANIZER_ROLE_NAME=Organisateur de Parties

# Taille d'une équipe (Valorant compétitif = 5)
TEAM_SIZE=5
