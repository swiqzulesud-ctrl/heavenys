{
  "schemaVersion": 1,
  "id": "heavenys",
  "version": "${version}",
  "name": "Heavenys Client",
  "description": "Heavenys Client - an open-source, heaven-themed Minecraft client for Fabric. Custom ClickGUI, drag & drop HUD editor, visual tweaks and mod-compatibility integrations. Original work inspired by the open-source Sol Client (GPL-3.0).",
  "authors": [
    "Heavenys Client contributors"
  ],
  "contact": {
    "homepage": "https://github.com/swiqzulesud-ctrl/heavenys",
    "sources": "https://github.com/swiqzulesud-ctrl/heavenys"
  },
  "license": "GPL-3.0-or-later",
  "icon": "assets/heavenys/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.heavenys.client.HeavenysClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.2",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "sodium": "*",
    "lithium": "*",
    "ferritecore": "*",
    "voicechat": "*"
  }
}
